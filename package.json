{
  "name": "ai-capex-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "setup:local": "tsx scripts/setup-local.ts",
    "migrate": "tsx scripts/migrate.ts",
    "probe": "tsx scripts/cli.ts probe",
    "ingest": "tsx scripts/cli.ts ingest",
    "export": "tsx scripts/cli.ts export",
    "weekly:appendix": "tsx scripts/cli.ts weekly",
    "dev:api": "tsx watch app/server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "start": "tsx app/server/index.ts",
    "build": "tsx scripts/assert-local-build.ts && tsc --noEmit && vite build",
    "recovery:check": "tsx scripts/recovery-check.ts",
    "test": "vitest run",
    "test:local": "tsx scripts/test-local.ts",
    "test:e2e:local": "tsx scripts/test-local.ts --e2e",
    "test:e2e": "playwright test",
    "test:schema": "tsx scripts/cli.ts schema-tests",
    "build:permit-ui:cockpit": "PERMIT_UI_BASE=/permits/ PERMIT_UI_OUT=../../.local/permit-ui VITE_PERMIT_API_BASE=/permit-api VITE_COCKPIT_URL=/dashboard vite build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "exceljs": "4.4.0",
    "express": "4.22.3",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.55.1",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "4.17.23",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/supertest": "6.0.3",
    "prettier": "3.9.10",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.5",
    "vitest": "4.1.11"
  }
}
